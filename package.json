{
  "name": "obsidian-seafile-sync",
  "version": "1.1.1",
  "description": "Two-way sync of an Obsidian vault with a Seafile library (desktop + mobile)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node test/build-tests.mjs && node test/out/sync.test.js",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/grissspy/obsidian-seafile-sync.git"
  }
}
